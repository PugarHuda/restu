{
  "name": "restu-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --experimental-strip-types --no-warnings src/main.ts",
    "dev": "node --experimental-strip-types --no-warnings --watch src/main.ts",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "eval": "node --experimental-strip-types --no-warnings eval/scam-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "typescript": "^5.9.3"
  }
}
