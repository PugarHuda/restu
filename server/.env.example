# --- core -------------------------------------------------------------------
PORT=8787
DB_PATH=data/restu.db
# Seeds the Acme demo (/v1/demo/acme, Telegram /demo) and a demo meeting when no calendar is set.
DEMO_MODE=1
# Agents that may file requests over HTTP/MCP: agentId:key,agentId:key
AGENT_KEYS=invoice-agent:change-me-1,followup-agent:change-me-2,calendar-agent:change-me-3

# --- Telegram (BotFather token). Without it, glasses auto-pair (simulator mode). --
TELEGRAM_BOT_TOKEN=
# Bots allowed to file requests bot-to-bot (Bot API 10.0), comma separated usernames
BOT_ALLOWLIST=
# Telegram username playing "Omar from Acme" in the demo (must /start the bot to be reachable)
DEMO_CONTACT=omar_acme
# Fallback wallet-card address for the demo contact if their profile has none (testnet)
DEMO_RECIPIENT_CARD=

# --- TON testnet: the agent's spending wallet (24 words). Fund it at @testgiver_ton_bot --
AGENT_WALLET_MNEMONIC=
TONCENTER_API_KEY=

# --- Claude (follow-up drafts, spoken corrections). Optional: falls back to templates --
ANTHROPIC_API_KEY=

# --- Speech-to-text (any OpenAI-compatible /audio/transcriptions endpoint) ---
STT_URL=https://api.groq.com/openai/v1/audio/transcriptions
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo

# --- ASK: Google Sheet (API key for a link-shared sheet, or OAuth refresh token) --
GOOGLE_SHEET_ID=
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar secret iCal address (Google Calendar → Settings → "Secret address in iCal format")
CALENDAR_ICS_URL=
